# ============================================================================
# Task Manager – Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================================

# --- Database ---
DATABASE_URL=postgres://taskmanager:secretpassword@db:5432/taskmanager?sslmode=disable
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=taskmanager

# --- JWT Authentication ---
JWT_SECRET=change-this-to-a-very-long-random-secret-key-in-production
JWT_EXPIRATION=24h

# --- Go API Server ---
API_PORT=8080

# --- CORS Allowed Origins ---
# ⚠️  IMPORTANT — CREDENTIAL COMPATIBILITY REQUIREMENT
# This variable MUST contain the EXACT origin (scheme + host + port) of the
# frontend deployment. For example:
#   - Local dev:     http://localhost:3000
#   - Vercel staging: https://task-manager-git-staging.vercel.app
#   - Production:     https://tasks.yourdomain.com
#
# RULES:
#   1. Do NOT use a wildcard (*) — wildcard origins are incompatible with
#      Access-Control-Allow-Credentials: true (cookies will be rejected).
#   2. Provide a SINGLE origin value. For multiple environments, manage
#      via CI/CD pipeline injection.
#   3. Trailing slashes are not permitted.
#
# The value set here must match the window.location.origin of the browser.
API_ALLOWED_ORIGINS=http://localhost:3000

# --- Next.js Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_SERVER_API_URL=http://api:8080/api